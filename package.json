{
  "name": "my-little-cat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Animated 2D Sprite Mobile Cat Life Simulator (Meowchi)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:sprites": "node scripts/build_all_sprites.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "phaser": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
